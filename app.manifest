<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!--
    Capture 的应用程序清单。

    之前没有这个文件，链接器会生成一份只带默认 identity 的最小清单。对发布版的实际影响：
      1. 没有 supportedOS 声明，系统把进程当成 Win7/8 处理 —— DPI 虚拟化、
         部分 API 的行为分支都按旧版本走；
      2. 没有 activeCodePage=UTF-8，中文系统上走 ANSI 代码页的第三方代码会踩 CP936；
      3. 没有 longPathAware，深路径下 MAX_PATH 限制生效。

    注意：
      - 版本号不在此处手写，与 exe 版本资源同源于 src/core/version.h 的意图一致，
        但清单里的 version 是「程序集版本」，与用户看到的显示版本无关，故写死 1.0.0.0
        是可以的（不会导致双击看不到版本号，那个读的是 VS_VERSION_INFO）。
      - heapType=SegmentHeap 由 vcxproj 的 <EnableSegmentHeap> 自动注入，
        这里不要重复写，否则 mt.exe 合并时会冲突。
  -->
  <assemblyIdentity type="win32" name="AdonisZeng.Capture" version="1.0.0.0" processorArchitecture="*" />

  <description>Capture 屏幕截取与录制</description>

  <!-- 使用 comctl32 v6（主题化公共控件）。缺这一段时 Explorer 里 exe 显示为
       无主题的经典外观。 -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker：录屏要抓整个桌面，管理员权限既无必要也会让 WGC 的
             画面/音频会话在部分机器上取不到；显式声明避免被虚拟化改写。 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- PerMonitorV2：混合 DPI 的多显示器下窗口不糊。src/main.cpp 里的
           ImGui_ImplWin32_EnableDpiAwareness() 是运行时兜底，清单才是权威来源
           （必须在窗口创建之前生效）。 -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>

      <!-- 突破 MAX_PATH：本程序把配置/日志路径拼在 exe 目录上，
           装在深目录（\\?\ 之外的 UNC 或长用户目录）时可能超过 260。 -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>

      <!-- 进程内 ANSI 代码页按 UTF-8 处理（Windows 10 1903+ 生效，低版本忽略）。
           本程序自己的文件 IO 全走 W 版 API，不受影响；这条是给第三方
           /系统组件兜底，避免中文路径在 ANSI 调用里被按 GBK 误解。 -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Win10 / Win11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

</assembly>